# PAL COMMAND variable names only. Do not put real credentials in this file.
# The production launcher reads DPAPI-encrypted values from the local automation
# directory and passes them to the bot process at runtime.

PALCMD_DISCORD_TOKEN=replace-with-local-token
PALCMD_DISCORD_CHANNEL=replace-with-channel-id
PALCMD_ADMIN_PW=replace-with-local-admin-password
PALCMD_MODS_REPO=C:\path\to\palworld-mods